<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head')%>
    <title>Homepage</title>
</head>
<body>
    <%- include('./partials/nav')%>
     <%# JSON.stringify(blogs) %>          <!-- iss current user ko navebar me  rkhna hai. -->

    <div class="container mt -3">

        <% blogs.forEach(blog => { %>
             <!-- we wants to render a card -->

   <div class="card" style="width: 18rem;">
        <img src="<%= blog.coverImageURL %>" class="card-img-top">
        <div class="card-body">
         <h5 class="card-title"><%= blog.tittle %></h5>
            
            <a href="/blog/<%= blog._id %>" class="btn btn-primary">View</a>
    </div>
</div>

        <% }) %>
    </div>
    <%- include('./partials/scripts')  %>
</body>
</html>











